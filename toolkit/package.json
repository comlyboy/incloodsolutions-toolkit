{
	"name": "@incloodsolutions/toolkit",
	"version": "0.1.8",
	"description": "A lightweight, framework-agnostic toolkit providing common utilities, helpers, and abstractions for building scalable JavaScript and TypeScript applications.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"homepage": "https://www.npmjs.com/package/@incloodsolutions/toolkit",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"author": "Inclood Solutions",
	"private": false,
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"toolkit",
		"utilities",
		"javascript",
		"typescript",
		"helpers",
		"library",
		"functions",
		"open-source",
		"shared",
		"incloodsolutions"
	],
	"scripts": {
		"prebuild": "rimraf dist",
		"build:cdk": "rimraf dist && mkdir -p dist/nodejs && cp package*.json dist/nodejs && npm i --omit=dev --prefix dist/nodejs && du -sh dist/nodejs/node_modules",
		"buildd": "tsc",
		"build": "tsup",
		"build:cjs": "tsc -p tsconfig.cjs.json",
		"build:esm": "tsc -p tsconfig.esm.json",
		"version:patch": "npm version patch --no-git-tag-version",
		"package": "npm run build && npm pack",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest"
	},
	"dependencies": {
		"axios": "^1.20.0",
		"handlebars": "^4.7.9",
		"libphonenumber-js": "^1.13.12",
		"nanoid": "^6.0.1",
		"tslib": "^2.8.1",
		"validator": "^13.15.35",
		"xml2js": "^0.6.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"@types/validator": "^13.15.10",
		"@types/xml2js": "^0.4.14",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2"
	}
}