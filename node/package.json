{
	"name": "@incloodsolutions/node-toolkit",
	"version": "0.0.14",
	"description": "A toolkit containing utility, helper, config, interfaces for nodejs apps",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"homepage": "https://www.npmjs.com/package/@incloodsolutions/node-toolkit",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"author": "Inclood Solutions",
	"private": false,
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"node",
		"nodejs",
		"utilities",
		"toolkit",
		"javascript",
		"typescript",
		"backend",
		"helpers",
		"library",
		"incloodsolutions"
	],
	"scripts": {
		"prebuild": "rimraf dist",
		"build:cdk": "rimraf dist && mkdir -p dist/nodejs && cp package*.json dist/nodejs && npm i --omit=dev --prefix dist/nodejs && du -sh dist/nodejs/node_modules",
		"buildd": "tsc",
		"build": "tsup",
		"version:patch": "npm version patch --no-git-tag-version",
		"package": "npm run build && npm pack",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1126.0",
		"@aws-sdk/client-ses": "^3.1126.0",
		"@aws-sdk/client-sns": "^3.1126.0",
		"@aws-sdk/lib-dynamodb": "^3.1126.0",
		"@aws-sdk/s3-request-presigner": "^3.1126.0",
		"@codegenie/serverless-express": "^5.0.0",
		"@incloodsolutions/toolkit": "^0.1.8",
		"bcryptjs": "^3.0.3",
		"bwip-js": "^4.11.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"crypto-js": "^4.2.0",
		"handlebars": "^4.7.9",
		"mongoose": "^9.9.4",
		"morgan": "^1.12.0",
		"tslib": "^2.8.1",
		"uuid": "^14.0.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@swc/core": "^1.16.1",
		"@types/aws-lambda": "^8.10.163",
		"@types/bcryptjs": "^3.0.0",
		"@types/crypto-js": "^4.2.2",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.4.1",
		"aws-sdk-client-mock": "^4.1.0",
		"jest": "^30.5.1",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"unplugin-swc": "^1.5.11",
		"vitest": "^5.0.0"
	}
}
