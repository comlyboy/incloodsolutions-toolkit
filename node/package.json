{
	"name": "@incloodsolutions/node-toolkit",
	"version": "0.0.15",
	"description": "A toolkit containing utility, helper, config, interfaces for nodejs apps",
	"type": "module",
	"sideEffects": false,
	"homepage": "https://www.npmjs.com/package/@incloodsolutions/node-toolkit",
		"repository": {
    "type": "git",
    "url": "https://github.com/comlyboy/incloodsolutions-toolkit.git"
  },
	"exports": {
		"./aws": {
			"types": "./dist/aws.d.ts",
			"import": "./dist/aws.js",
			"require": "./dist/aws.cjs"
		},
		"./aws-lambda": {
			"types": "./dist/aws-lambda.d.ts",
			"import": "./dist/aws-lambda.js",
			"require": "./dist/aws-lambda.cjs"
		},
		"./aws-cli": {
			"types": "./dist/aws-cli.d.ts",
			"import": "./dist/aws-cli.js",
			"require": "./dist/aws-cli.cjs"
		},
		"./aws-sdk": {
			"types": "./dist/aws-sdk.d.ts",
			"import": "./dist/aws-sdk.js",
			"require": "./dist/aws-sdk.cjs"
		},
		"./aws-sdk/s3": {
			"types": "./dist/aws-sdk/s3.d.ts",
			"import": "./dist/aws-sdk/s3.js",
			"require": "./dist/aws-sdk/s3.cjs"
		},
		"./aws-sdk/ses": {
			"types": "./dist/aws-sdk/ses.d.ts",
			"import": "./dist/aws-sdk/ses.js",
			"require": "./dist/aws-sdk/ses.cjs"
		},
		"./aws-sdk/sns": {
			"types": "./dist/aws-sdk/sns.d.ts",
			"import": "./dist/aws-sdk/sns.js",
			"require": "./dist/aws-sdk/sns.cjs"
		},
		"./aws-sdk/dynamo-db": {
			"types": "./dist/aws-sdk/dynamo-db.d.ts",
			"import": "./dist/aws-sdk/dynamo-db.js",
			"require": "./dist/aws-sdk/dynamo-db.cjs"
		},
		"./aws-sdk/event-bridge": {
			"types": "./dist/aws-sdk/event-bridge.d.ts",
			"import": "./dist/aws-sdk/event-bridge.js",
			"require": "./dist/aws-sdk/event-bridge.cjs"
		},
		"./gcp": {
			"types": "./dist/gcp.d.ts",
			"import": "./dist/gcp.js",
			"require": "./dist/gcp.cjs"
		},
		"./mongo": {
			"types": "./dist/mongo.d.ts",
			"import": "./dist/mongo.js",
			"require": "./dist/mongo.cjs"
		},
		"./utility": {
			"types": "./dist/utility.d.ts",
			"import": "./dist/utility.js",
			"require": "./dist/utility.cjs"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js",
			"require": "./dist/config.cjs"
		},
		"./interface": {
			"types": "./dist/interface.d.ts",
			"import": "./dist/interface.js",
			"require": "./dist/interface.cjs"
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"aws": ["./dist/aws.d.ts"],
			"aws-lambda": ["./dist/aws-lambda.d.ts"],
			"aws-cli": ["./dist/aws-cli.d.ts"],
			"aws-sdk": ["./dist/aws-sdk.d.ts"],
			"aws-sdk/s3": ["./dist/aws-sdk/s3.d.ts"],
			"aws-sdk/ses": ["./dist/aws-sdk/ses.d.ts"],
			"aws-sdk/sns": ["./dist/aws-sdk/sns.d.ts"],
			"aws-sdk/dynamo-db": ["./dist/aws-sdk/dynamo-db.d.ts"],
			"aws-sdk/event-bridge": ["./dist/aws-sdk/event-bridge.d.ts"],
			"gcp": ["./dist/gcp.d.ts"],
			"mongo": ["./dist/mongo.d.ts"],
			"utility": ["./dist/utility.d.ts"],
			"config": ["./dist/config.d.ts"],
			"interface": ["./dist/interface.d.ts"]
		}
	},
	"engines": {
		"node": ">=24"
	},
	"author": "Inclood Solutions",
	"private": false,
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"node",
		"nodejs",
		"utilities",
		"toolkit",
		"javascript",
		"typescript",
		"backend",
		"helpers",
		"library",
		"incloodsolutions"
	],
	"scripts": {
		"prebuild": "rimraf dist",
		"build:cdk": "rimraf dist && mkdir -p dist/nodejs && cp package*.json dist/nodejs && npm i --omit=dev --prefix dist/nodejs && du -sh dist/nodejs/node_modules",
		"buildd": "tsc",
		"build": "tsup",
		"version:patch": "npm version patch --no-git-tag-version",
		"package": "npm run build && npm pack",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1130.0",
		"@aws-sdk/client-ses": "^3.1130.0",
		"@aws-sdk/client-sns": "^3.1130.0",
		"@aws-sdk/lib-dynamodb": "^3.1130.0",
		"@aws-sdk/s3-request-presigner": "^3.1130.0",
		"@codegenie/serverless-express": "^5.0.0",
		"@incloodsolutions/toolkit": "^0.1.10",
		"bcryptjs": "^3.0.3",
		"bwip-js": "^4.11.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"crypto-js": "^4.2.0",
		"handlebars": "^4.7.9",
		"mongoose": "^9.10.0",
		"morgan": "^1.12.0",
		"tslib": "^2.8.1",
		"uuid": "^14.0.2",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@swc/core": "^1.16.2",
		"@types/aws-lambda": "^8.10.163",
		"@types/bcryptjs": "^3.0.0",
		"@types/crypto-js": "^4.2.2",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.4.1",
		"aws-sdk-client-mock": "^4.1.0",
		"jest": "^30.5.1",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"unplugin-swc": "^1.6.0",
		"vitest": "^5.0.0"
	}
}
