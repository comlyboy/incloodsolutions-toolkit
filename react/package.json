{
	"name": "@incloodsolutions/react-toolkit",
	"version": "0.0.5",
	"description": "A collection of reusable React utilities, hooks, and components designed to accelerate development and improve code consistency across React applications.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"homepage": "https://www.npmjs.com/package/@incloodsolutions/react-toolkit",
	"repository": {
		"type": "git",
		"url": "https://github.com/comlyboy/incloodsolutions-toolkit.git"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"author": "Inclood Solutions",
	"private": false,
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"components",
		"react",
		"react-hooks",
		"react-components",
		"react-toolkit",
		"ui",
		"frontend",
		"library",
		"typescript",
		"javascript",
		"utilities",
		"incloodsolutions"
	],
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsup",
		"buildd": "npm run prebuild && npx vite build",
		"version:patch": "npm version patch --no-git-tag-version",
		"package": "npm run build && npm pack",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@incloodsolutions/toolkit": "^0.1.11",
		"clsx": "^2.1.1",
		"joi": "^18.2.9",
		"localforage": "^1.10.0",
		"radix-ui": "^1.6.7",
		"react-hook-form": "^7.88.0",
		"react-use": "^17.6.1",
		"tailwind-merge": "^3.7.0",
		"usehooks-ts": "^3.1.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prettier": "^3.9.9",
		"react": ">=19.3.0",
		"react-dom": ">=19.3.0",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react-dom": {
			"optional": true
		}
	}
}