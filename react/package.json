{
	"name": "@incloodsolutions/react-toolkit",
	"version": "0.0.5",
	"description": "A collection of reusable React utilities, hooks, and components designed to accelerate development and improve code consistency across React applications.",
	"type": "module",
	"sideEffects": false,
	"homepage": "https://www.npmjs.com/package/@incloodsolutions/react-toolkit",
	"repository": {
		"type": "git",
		"url": "https://github.com/comlyboy/incloodsolutions-toolkit.git"
	},
	"exports": {
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"import": "./dist/hooks.js"
		},
		"./utilities": {
			"types": "./dist/utilities.d.ts",
			"import": "./dist/utilities.js"
		},
		"./validators": {
			"types": "./dist/validators.d.ts",
			"import": "./dist/validators.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"hooks": [
				"./dist/hooks.d.ts"
			],
			"utilities": [
				"./dist/utilities.d.ts"
			],
			"validators": [
				"./dist/validators.d.ts"
			],
			"types": [
				"./dist/types.d.ts"
			]
		}
	},
	"author": "Inclood Solutions",
	"private": false,
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"components",
		"react",
		"react-hooks",
		"react-components",
		"react-toolkit",
		"ui",
		"frontend",
		"library",
		"typescript",
		"javascript",
		"utilities",
		"incloodsolutions"
	],
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsup",
		"buildd": "npm run prebuild && npx vite build",
		"version:patch": "npm version patch --no-git-tag-version",
		"package": "npm run build && npm pack",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest"
	},
	"dependencies": {
		"@hookform/resolvers": "^7.0.6",
		"@incloodsolutions/toolkit": "^0.1.17",
		"clsx": "^2.1.1",
		"localforage": "^1.10.0",
		"radix-ui": "^1.8.1",
		"react-hook-form": "^7.92.0",
		"react-use": "^17.6.1",
		"tailwind-merge": "^3.7.0",
		"usehooks-ts": "^3.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prettier": "^3.10.1",
		"react": ">=19.3.1",
		"react-dom": ">=19.3.1",
		"rimraf": "^6.1.4",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react-dom": {
			"optional": true
		}
	}
}