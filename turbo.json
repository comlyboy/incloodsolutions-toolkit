{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"test:watch": {
			"cache": false,
			"persistent": true
		},
		"test:coverage": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"format": {
			"cache": false
		},
		"package": {
			"dependsOn": ["build"],
			"cache": false
		},
		"clean": {
			"cache": false
		}
	}
}
