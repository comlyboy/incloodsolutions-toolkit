{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrder": [
		"<BUILTIN_MODULES>",
		"",
		"<THIRD_PARTY_MODULES>",
		"",
		"^@incloodsolutions/(.*)$",
		"",
		"^[.]"
	],
	"importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
	"importOrderTypeScriptVersion": "5.0.0",
	"importOrderCaseSensitive": false,
	"overrides": [
		{
			"files": "packages/angular/**/*.{ts,html}",
			"options": {
				"useTabs": false,
				"tabWidth": 2,
				"printWidth": 100
			}
		},
		{
			"files": "packages/angular/**/*.html",
			"options": {
				"parser": "angular"
			}
		}
	]
}
