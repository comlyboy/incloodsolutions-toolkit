			"types": "./dist/aws-cdk/constructs/role-policy.d.ts",
			"import": "./dist/aws-cdk/constructs/role-policy.js",
			"require": "./dist/aws-cdk/constructs/role-policy.cjs"
		},
		"./aws-cdk/constructs/route53": {
			"types": "./dist/aws-cdk/constructs/route53.d.ts",
			"import": "./dist/aws-cdk/constructs/route53.js",
			"require": "./dist/aws-cdk/constructs/route53.cjs"
		},
		"./aws-cdk/constructs/s3": {
			"types": "./dist/aws-cdk/constructs/s3.d.ts",
			"import": "./dist/aws-cdk/constructs/s3.js",
