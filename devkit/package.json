{
	"name": "@incloodsolutions/devkit",
	"version": "0.0.6",
	"description": "A comprehensive development toolkit for Node.js and TypeScript, providing development utilities, configuration helpers, AWS CDK constructs, stacks, and infrastructure tooling.",
	"type": "module",
	"sideEffects": false,
	"homepage": "https://www.npmjs.com/package/@incloodsolutions/devkit",
	"repository": {
		"type": "git",
		"url": "https://github.com/comlyboy/incloodsolutions-toolkit.git"
	},
	"exports": {
		"./aws": {
			"types": "./dist/aws.d.ts",
			"import": "./dist/aws.js",
			"require": "./dist/aws.cjs"
		},
		"./aws-types": {
			"types": "./dist/aws-types.d.ts",
			"import": "./dist/aws-types.js",
			"require": "./dist/aws-types.cjs"
		},
		"./aws-cdk/constructs/api-gateway": {
			"types": "./dist/aws-cdk/constructs/api-gateway.d.ts",
			"import": "./dist/aws-cdk/constructs/api-gateway.js",
			"require": "./dist/aws-cdk/constructs/api-gateway.cjs"
		},
		"./aws-cdk/constructs/api-gateway-v2": {
