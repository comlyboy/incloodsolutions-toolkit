		},
		"./aws-cdk/constructs/sqs": {
			"types": "./dist/aws-cdk/constructs/sqs.d.ts",
			"import": "./dist/aws-cdk/constructs/sqs.js",
			"require": "./dist/aws-cdk/constructs/sqs.cjs"
		},
		"./aws-cdk/constructs/vpc": {
			"types": "./dist/aws-cdk/constructs/vpc.d.ts",
			"import": "./dist/aws-cdk/constructs/vpc.js",
			"require": "./dist/aws-cdk/constructs/vpc.cjs"
		},
