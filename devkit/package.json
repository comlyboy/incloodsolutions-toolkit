			"types": "./dist/aws-cdk/constructs/lambda-authorizer.d.ts",
			"import": "./dist/aws-cdk/constructs/lambda-authorizer.js",
			"require": "./dist/aws-cdk/constructs/lambda-authorizer.cjs"
		},
		"./aws-cdk/constructs/lambda-authorizer-v2": {
			"types": "./dist/aws-cdk/constructs/lambda-authorizer-v2.d.ts",
			"import": "./dist/aws-cdk/constructs/lambda-authorizer-v2.js",
			"require": "./dist/aws-cdk/constructs/lambda-authorizer-v2.cjs"
		},
		"./aws-cdk/constructs/lambda-layer": {
			"types": "./dist/aws-cdk/constructs/lambda-layer.d.ts",
			"import": "./dist/aws-cdk/constructs/lambda-layer.js",
			"require": "./dist/aws-cdk/constructs/lambda-layer.cjs"
		},
