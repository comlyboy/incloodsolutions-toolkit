			"types": "./dist/aws-cdk/stacks/lambda-api.d.ts",
			"import": "./dist/aws-cdk/stacks/lambda-api.js",
			"require": "./dist/aws-cdk/stacks/lambda-api.cjs"
		},
		"./aws-cdk/stacks/lambda-sns": {
			"types": "./dist/aws-cdk/stacks/lambda-sns.d.ts",
			"import": "./dist/aws-cdk/stacks/lambda-sns.js",
			"require": "./dist/aws-cdk/stacks/lambda-sns.cjs"
		},
		"./aws-cdk/stacks/lambda-sqs": {
			"types": "./dist/aws-cdk/stacks/lambda-sqs.d.ts",
			"import": "./dist/aws-cdk/stacks/lambda-sqs.js",
			"require": "./dist/aws-cdk/stacks/lambda-sqs.cjs"
		},
		"./package.json": "./package.json"
	},
	"author": "Inclood Solutions",
	"private": false,
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"aws",
		"aws-cdk",
		"node",
		"linting",
		"utilities",
		"toolkit",
		"javascript",
		"typescript",
		"prettier",
		"helpers",
		"library",
		"incloodsolutions"
	],
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "NODE_OPTIONS=--max-old-space-size=4096 tsup",
		"version:patch": "npm version patch --no-git-tag-version",
		"package": "npm run build && npm pack",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@incloodsolutions/toolkit": "^0.1.11",
		"aws-cdk-lib": "^2.269.0",
		"constructs": "^10.8.1",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@types/node": "^26.5.1",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"ts-node": "^10.9.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"typesVersions": {
		"*": {
			"aws": ["./dist/aws.d.ts"],
			"aws-types": ["./dist/aws-types.d.ts"],
			"aws-cdk/constructs/api-gateway": ["./dist/aws-cdk/constructs/api-gateway.d.ts"],
			"aws-cdk/constructs/api-gateway-v2": ["./dist/aws-cdk/constructs/api-gateway-v2.d.ts"],
			"aws-cdk/constructs/api-gateway-websocket": ["./dist/aws-cdk/constructs/api-gateway-websocket.d.ts"],
			"aws-cdk/constructs/cloudfront": ["./dist/aws-cdk/constructs/cloudfront.d.ts"],
			"aws-cdk/constructs/cloudwatch": ["./dist/aws-cdk/constructs/cloudwatch.d.ts"],
			"aws-cdk/constructs/dynamo-db": ["./dist/aws-cdk/constructs/dynamo-db.d.ts"],
			"aws-cdk/constructs/event-bridge": ["./dist/aws-cdk/constructs/event-bridge.d.ts"],
			"aws-cdk/constructs/lambda": ["./dist/aws-cdk/constructs/lambda.d.ts"],
			"aws-cdk/constructs/lambda-authorizer": ["./dist/aws-cdk/constructs/lambda-authorizer.d.ts"],
			"aws-cdk/constructs/lambda-authorizer-v2": ["./dist/aws-cdk/constructs/lambda-authorizer-v2.d.ts"],
			"aws-cdk/constructs/lambda-layer": ["./dist/aws-cdk/constructs/lambda-layer.d.ts"],
			"aws-cdk/constructs/role-policy": ["./dist/aws-cdk/constructs/role-policy.d.ts"],
			"aws-cdk/constructs/route53": ["./dist/aws-cdk/constructs/route53.d.ts"],
			"aws-cdk/constructs/s3": ["./dist/aws-cdk/constructs/s3.d.ts"],
			"aws-cdk/constructs/s3-deployment": ["./dist/aws-cdk/constructs/s3-deployment.d.ts"],
			"aws-cdk/constructs/sns": ["./dist/aws-cdk/constructs/sns.d.ts"],
			"aws-cdk/constructs/sqs": ["./dist/aws-cdk/constructs/sqs.d.ts"],
			"aws-cdk/constructs/vpc": ["./dist/aws-cdk/constructs/vpc.d.ts"],
			"aws-cdk/stacks/lambda-api": ["./dist/aws-cdk/stacks/lambda-api.d.ts"],
			"aws-cdk/stacks/lambda-sns": ["./dist/aws-cdk/stacks/lambda-sns.d.ts"],
			"aws-cdk/stacks/lambda-sqs": ["./dist/aws-cdk/stacks/lambda-sqs.d.ts"]
		}
	}
}
