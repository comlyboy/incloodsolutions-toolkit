{
	"name": "incloodsolutions-toolkit",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for the @incloodsolutions toolkits: core, Node.js, React, Angular, AWS CDK and MCP.",
	"repository": {
		"type": "git",
		"url": "https://github.com/comlyboy/incloodsolutions-toolkit.git"
	},
	"license": "MIT",
	"packageManager": "npm@11.12.1",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"build:toolkit": "turbo run build --filter=@incloodsolutions/toolkit",
		"build:node": "turbo run build --filter=@incloodsolutions/node-toolkit",
		"build:devkit": "turbo run build --filter=@incloodsolutions/devkit",
		"build:react": "turbo run build --filter=@incloodsolutions/react-toolkit",
		"build:angular": "turbo run build --filter=angular-toolkit",
		"build:mcp": "turbo run build --filter=@incloodsolutions/mcp",
		"test": "turbo run test",
		"test:toolkit": "turbo run test --filter=@incloodsolutions/toolkit",
		"test:node": "turbo run test --filter=@incloodsolutions/node-toolkit",
		"test:devkit": "turbo run test --filter=@incloodsolutions/devkit",
		"test:react": "turbo run test --filter=@incloodsolutions/react-toolkit",
		"test:angular": "turbo run test --filter=angular-toolkit",
		"test:mcp": "turbo run test --filter=@incloodsolutions/mcp",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"clean": "turbo run clean"
	},
	"devDependencies": {
		"turbo": "^2.11.12"
	}
}
